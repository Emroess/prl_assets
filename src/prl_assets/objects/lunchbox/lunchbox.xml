<mujoco model="lunchbox">
  <compiler angle="radian"/>

  <asset>
    <texture name="lunchbox_tex" type="2d" file="lunchbox_texture.png"/>
    <material name="lunchbox_mat" texture="lunchbox_tex" specular="0.5" shininess="0.5"/>
    <mesh name="lunchbox_visual" file="lunchbox_visual.obj"/>
  </asset>

  <worldbody>
    <body name="lunchbox" pos="0 0 0.05187">
      <freejoint name="lunchbox_joint"/>

      <!-- Collision geometry: the visual mesh's convex hull (authoring.hull_of); no box fits the bag's bulging faces -->
      <geom name="lunchbox_collision" type="mesh" pos="0 0 0" mesh="lunchbox_visual" mass="0.4" friction="0.7 0.005 0.0001" group="3" condim="4" contype="1" conaffinity="1"/>

      <!-- Visual mesh -->
      <geom name="lunchbox_visual" group="2" mass="0"
            type="mesh"
            mesh="lunchbox_visual"
            material="lunchbox_mat"
            contype="0"
            conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
